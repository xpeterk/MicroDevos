# Copy to .env and fill in only what you have. Leave blanks to run on sample data.
# Do not commit .env. This milestone does not call a model, so there is no
# embedding API key.

# Flutter, passed with --dart-define (see README).
SUPABASE_URL=
SUPABASE_ANON_KEY=
ESV_API_KEY=
API_BIBLE_KEY=
API_BIBLE_ID_NIV=
API_BIBLE_ID_NLT=
API_BIBLE_ID_NKJV=
API_BIBLE_ID_CSB=
API_BIBLE_ID_NASB=

# Notion import and the ingest function. Do not commit real values.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=515d5d5d-b81b-4751-a025-d2c0734e3f60
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Banner images come from this public edition feed.
RSS_FEED_URL=https://microdevotionals.substack.com/feed
INGEST_SHARED_SECRET=

# generate-devo. The fake provider is the only implementation. No model key.
# The weekly cap and the monthly spend ceiling are placeholders, not decided.
GENERATION_PROVIDER=fake
WEEKLY_GENERATION_CAP=5
MONTHLY_SPEND_CEILING_USD=25

# Help line under the next step. Leave blank to use the placeholder sentence
# and the default topic list. Wording and triggers are pending final approval.
HELP_NOTE=
HELP_NOTE_TRIGGERS=

# Android release signing. Point RELEASE_STORE_FILE at a keystore kept
# outside the repo. Do not commit the keystore or these passwords.
# Leave blank and a release build uses the machine debug key. To update
# an existing install in place, use the same keystore that signed it.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
